---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { SERVICES, serviceHref } from '@/data/services';
---

<BaseLayout headerTheme="light" title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="nf theme-light grain" aria-labelledby="nf-title">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="container nf__inner">
      <div class="nf__mark" aria-hidden="true">
        <Logo variant="icon" decorative />
      </div>
      <p class="eyebrow eyebrow--center">Error 404</p>
      <h1 id="nf-title" class="h1">This page has <em class="accent">moved</em> or doesn’t exist</h1>
      <p class="lead">Let’s get you back on track. Try one of these pages instead.</p>
      <div class="btn-row nf__actions">
        <a class="btn btn--gold btn--lg" href="/">Back to home <Icon name="arrow-right" class="icon--arrow" stroke={2} /></a>
        <a class="btn btn--outline btn--lg" href="/contact/">Contact us</a>
      </div>
      <ul class="nf__links" role="list">
        {
          SERVICES.slice(0, 6).map((s) => (
            <li>
              <a href={serviceHref(s.slug)}>{s.navTitle}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: clip;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 3rem) 0 5rem;
    background:
      radial-gradient(110% 70% at 80% -10%, rgb(212 175 106 / 0.26) 0%, rgb(212 175 106 / 0.07) 38%, transparent 64%),
      linear-gradient(180deg, #ffffff 0%, #fdfaf4 50%, #f4ece0 100%);
    text-align: center;
  }

  .nf :global(.bg-grid) {
    background-image:
      linear-gradient(rgb(6 23 49 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(6 23 49 / 0.045) 1px, transparent 1px);
  }

  .nf.grain::before {
    opacity: 0.035;
    mix-blend-mode: multiply;
  }

  .nf__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 760px;
  }

  .nf__mark {
    width: 96px;
    color: var(--navy-900);
    margin-bottom: 0.5rem;
  }

  .nf__actions {
    justify-content: center;
    margin-top: 0.5rem;
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .nf__links a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: rgb(255 255 255 / 0.7);
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--fg-muted);
    transition:
      border-color 0.3s,
      color 0.3s;
  }

  .nf__links a:hover {
    border-color: var(--gold-600);
    color: var(--navy-900);
  }
</style>
