---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import ContactForm from '@/components/ContactForm.astro';
import Locations from '@/components/Locations.astro';
import GoldPanel from '@/components/GoldPanel.astro';
import { CONTACT, REGISTERED_OFFICE, whatsappLink } from '@/data/site';
import { breadcrumbSchema } from '@/data/schema';

const crumbs = [{ label: 'Contact' }];

const channels = [
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: CONTACT.whatsapp.display,
    href: whatsappLink(),
    note: 'Fastest way to reach us',
    external: true,
  },
  { icon: 'phone', label: 'Phone', value: CONTACT.phone.display, href: CONTACT.phone.href, note: 'Call to speak with our team' },
  { icon: 'mail', label: 'Email', value: CONTACT.email.display, href: CONTACT.email.href, note: 'Enquiries and quotations' },
  { icon: 'life-buoy', label: 'Support email', value: CONTACT.supportEmail.display, href: CONTACT.supportEmail.href, note: 'Help with an existing setup' },
];
---

<BaseLayout
  headerTheme="light"
  title="Contact Softkey Technologies — Kannur, Payyannur & Mangaluru"
  description="Contact Softkey Technologies on WhatsApp 9544 101 401, phone 9846 901 101 or tallygoldpartner@gmail.com. Branches in Kannur, Payyannur and Mangaluru."
  schema={[breadcrumbSchema(crumbs, '/contact/'), { '@type': 'ContactPage', name: 'Contact Softkey Technologies', url: 'https://tallygoldpartner.in/contact/' }]}
>
  <PageHero
    eyebrow="Contact"
    title={`Let’s talk about <em class="accent">your business</em>`}
    lead="Whether you need a new license, help with an existing setup or advice on where to start — send us a message and the right person will get back to you."
    crumbs={crumbs}
  >
    <GoldPanel slot="media" variant="contact" />
  </PageHero>

  <section class="ct theme-light section" aria-label="Contact details and enquiry form">
    <div class="container ct__grid">
      <div class="ct__aside">
        <p class="eyebrow" data-reveal>Reach us directly</p>
        <h2 class="h2 ct__title" data-reveal style="--d:1">Prefer a <em class="accent">quick</em> chat?</h2>

        <ul class="ch" role="list">
          {
            channels.map((c, i) => (
              <li data-reveal style={`--d:${i + 1}`}>
                <a class="ch__item" href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="ch__icon">
                    <Icon name={c.icon} size={22} />
                  </span>
                  <span class="ch__body">
                    <small>{c.label}</small>
                    <strong>{c.value}</strong>
                    <span>{c.note}</span>
                  </span>
                  <Icon name="arrow-up-right" size={18} class="ch__arrow" />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="ct__office" data-reveal style="--d:5">
          <Icon name="building-2" size={20} />
          <div>
            <strong>Registered office</strong>
            <address>
              Softkey Technologies Pvt. Ltd.<br />
              {REGISTERED_OFFICE.lines.map((l) => (
                <>
                  {l}
                  <br />
                </>
              ))}
            </address>
          </div>
        </div>
      </div>

      <div class="ct__form" data-reveal="right" style="--d:2">
        <ContactForm />
      </div>
    </div>
  </section>

  <Locations eyebrow="Visit a branch" />
</BaseLayout>

<style>
  .ct__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .ct__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4.5rem;
    }
  }

  .ct__aside {
    display: grid;
    gap: 1.25rem;
  }

  .ct__title {
    margin-bottom: 0.5rem;
  }

  .ch {
    display: grid;
    gap: 0.75rem;
  }

  .ch__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem 1rem 1rem;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid rgb(6 23 49 / 0.07);
    box-shadow: 0 14px 30px -26px rgb(6 23 49 / 0.5);
    transition:
      transform 0.45s var(--ease-out),
      border-color 0.3s,
      box-shadow 0.45s var(--ease-out);
  }

  .ch__item:hover {
    transform: translateY(-3px);
    border-color: rgb(185 141 54 / 0.4);
    box-shadow: 0 24px 40px -28px rgb(6 23 49 / 0.55);
  }

  .ch__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--navy-900);
    color: var(--gold-300);
  }

  .ch__body {
    display: grid;
    line-height: 1.3;
    min-width: 0;
  }

  .ch__body small {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-700);
  }

  .ch__body strong {
    margin-top: 0.15rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg-strong);
    overflow-wrap: anywhere;
  }

  .ch__body span {
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
  }

  .ch__item :global(.ch__arrow) {
    color: var(--gold-700);
    transition: transform 0.4s var(--ease-out);
  }

  .ch__item:hover :global(.ch__arrow) {
    transform: translate(3px, -3px);
  }

  @media (max-width: 419px) {
    .ch__item {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.85rem;
    }
    .ch__item :global(.ch__arrow) {
      display: none;
    }
    .ch__body strong {
      font-size: 1rem;
    }
  }

  .ct__office {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    margin-top: 0.75rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px dashed var(--border-gold);
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }

  .ct__office :global(.icon) {
    color: var(--gold-700);
    margin-top: 0.1rem;
  }

  .ct__office strong {
    display: block;
    color: var(--fg-strong);
    margin-bottom: 0.2rem;
  }

  .ct__office address {
    font-style: normal;
    line-height: 1.6;
  }
</style>
