---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { Crumb } from '@/data/schema';

interface Props {
  eyebrow: string;
  /** Heading HTML — may contain <em class="accent">…</em> */
  title: string;
  lead: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  badgeIcon?: string;
  badgeText?: string;
}

const { eyebrow, title, lead, crumbs, image, imageAlt = '', badgeIcon, badgeText } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...crumbs];
---

<section class:list={['phero', 'theme-dark', 'grain', { 'phero--media': !!image }]} aria-labelledby="page-title">
  <div class="phero__bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-glow phero__glow"></div>
    {
      !image && (
        <svg class="phero__ring" viewBox="0 0 600 600">
          <circle cx="300" cy="300" r="280" fill="none" stroke="rgb(212 175 106 / .2)" stroke-width="1.2" stroke-dasharray="1500 260" stroke-dashoffset="-40" />
          <circle cx="300" cy="300" r="210" fill="none" stroke="rgb(255 255 255 / .06)" stroke-width="1" />
          <circle cx="498" cy="102" r="9" fill="#99EB26" />
        </svg>
      )
    }
  </div>

  <div class="container phero__inner">
    <div class="phero__copy">
      <nav aria-label="Breadcrumb" class="crumbs" data-reveal>
        <ol role="list">
          {
            trail.map((c, i) => (
              <li>
                {c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                {i < trail.length - 1 && <Icon name="chevron-right" size={14} />}
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="eyebrow" data-reveal style="--d:1">{eyebrow}</p>
      <h1 id="page-title" class="h1 phero__title" data-reveal style="--d:2" set:html={title} />
      <p class="lead phero__lead" data-reveal style="--d:3">{lead}</p>
      {
        Astro.slots.has('actions') && (
          <div class="btn-row btn-row--stack-sm phero__actions" data-reveal style="--d:4">
            <slot name="actions" />
          </div>
        )
      }
      <slot />
    </div>

    {
      image && (
        <div class="phero__media" data-reveal="zoom" style="--d:2">
          <div class="phero__line" aria-hidden="true" />
          <div class="frame phero__frame">
            <Picture src={image} formats={['avif', 'webp']} alt={imageAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 520px, 92vw" loading="eager" fetchpriority="high" />
          </div>
          {badgeIcon && badgeText && (
            <div class="phero__badge">
              <span class="icon-ring">
                <Icon name={badgeIcon} />
              </span>
              <span>{badgeText}</span>
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 1.5rem + 4vw, 5rem));
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: var(--grad-navy);
  }

  .phero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .phero__glow {
    width: 42rem;
    height: 42rem;
    right: -10rem;
    top: -12rem;
    background: radial-gradient(closest-side, rgb(35 76 160 / 0.5), transparent);
  }

  .phero__ring {
    position: absolute;
    right: max(-8rem, calc((100% - var(--container)) / 2 - 8rem));
    top: 50%;
    width: min(620px, 70vw);
    transform: translateY(-45%);
    opacity: 0.9;
    animation: phero-spin 90s linear infinite;
  }

  @media (max-width: 767px) {
    .phero__ring {
      opacity: 0.35;
      right: -40%;
      width: 110vw;
    }
  }

  .phero__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .phero--media .phero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
  }

  .phero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 46rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--ink-400);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .crumbs a {
    color: var(--ink-300);
    transition: color 0.25s;
  }

  .crumbs a:hover {
    color: var(--gold-300);
  }

  .crumbs [aria-current] {
    color: var(--gold-200);
  }

  .crumbs :global(.icon) {
    opacity: 0.5;
  }

  .phero__title {
    max-width: 18ch;
  }

  .phero:not(.phero--media) .phero__title {
    max-width: 20ch;
  }

  .phero__lead {
    max-width: 38rem;
  }

  .phero__actions {
    margin-top: 0.75rem;
  }

  @media (max-width: 479px) {
    .phero__actions {
      justify-self: stretch;
    }
  }

  .phero__media {
    position: relative;
    width: 100%;
    max-width: 560px;
    justify-self: center;
    padding: 0 0 1.5rem 1.5rem;
  }

  .phero__line {
    position: absolute;
    inset: 1.5rem 1.5rem 0 0;
    border: 1px solid rgb(212 175 106 / 0.35);
    border-radius: var(--radius-lg);
  }

  .phero__frame {
    aspect-ratio: 5 / 4;
  }

  .phero__badge {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: calc(100% - 2rem);
    padding: 0.7rem 1.2rem 0.7rem 0.7rem;
    border-radius: 999px;
    background: linear-gradient(160deg, rgb(24 44 92 / 0.9), rgb(6 16 38 / 0.94));
    border: 1px solid rgb(212 175 106 / 0.3);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
    color: #fff;
    font-weight: 650;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  @keyframes phero-spin {
    to {
      transform: translateY(-45%) rotate(360deg);
    }
  }
</style>
