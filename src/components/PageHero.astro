---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ScreenShot from './ScreenShot.astro';
import type { Crumb } from '@/data/schema';

interface Props {
  eyebrow: string;
  /** Heading HTML — may contain <em class="accent">…</em> */
  title: string;
  lead: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** "screen" frames the image as a TallyPrime product window instead of a photo */
  media?: 'photo' | 'screen';
  screenLabel?: string;
  badgeIcon?: string;
  badgeText?: string;
}

const { eyebrow, title, lead, crumbs, image, imageAlt = '', media = 'photo', screenLabel = 'TallyPrime', badgeIcon, badgeText } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...crumbs];
---

<section class:list={['phero', 'theme-light', 'grain', { 'phero--media': !!image || Astro.slots.has('media') }]} aria-labelledby="page-title">
  <div class="phero__bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-glow phero__glow"></div>
    {
      !image && !Astro.slots.has('media') && (
        <svg class="phero__ring" viewBox="0 0 600 600">
          <circle cx="300" cy="300" r="280" fill="none" stroke="rgb(185 141 54 / .35)" stroke-width="1.2" stroke-dasharray="1500 260" stroke-dashoffset="-40" />
          <circle cx="300" cy="300" r="210" fill="none" stroke="rgb(6 23 49 / .07)" stroke-width="1" />
          <circle cx="498" cy="102" r="9" fill="#99EB26" />
        </svg>
      )
    }
  </div>

  <div class="container phero__inner">
    <div class="phero__copy">
      <nav aria-label="Breadcrumb" class="crumbs" data-reveal>
        <ol role="list">
          {
            trail.map((c, i) => (
              <li>
                {c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                {i < trail.length - 1 && <Icon name="chevron-right" size={14} />}
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="eyebrow" data-reveal style="--d:1">{eyebrow}</p>
      <h1 id="page-title" class="h1 phero__title" data-reveal style="--d:2" set:html={title} />
      <p class="lead phero__lead" data-reveal style="--d:3">{lead}</p>
      {
        Astro.slots.has('actions') && (
          <div class="btn-row btn-row--stack-sm phero__actions" data-reveal style="--d:4">
            <slot name="actions" />
          </div>
        )
      }
      <slot />
    </div>

    {
      Astro.slots.has('media') && (
        <div class="phero__media phero__media--custom" data-reveal="zoom" style="--d:2">
          <slot name="media" />
        </div>
      )
    }

    {
      image && !Astro.slots.has('media') && (
        <div class="phero__media" data-reveal="zoom" style="--d:2">
          <div class="phero__line" aria-hidden="true" />
          {media === 'screen' ? (
            <ScreenShot
              src={image}
              alt={imageAlt}
              label={screenLabel}
              ratio="16 / 10"
              sizes="(min-width: 1024px) 620px, 92vw"
              widths={[480, 768, 1100, 1600]}
              loading="eager"
              class="phero__screen"
            />
          ) : (
            <div class="frame phero__frame">
              <Picture src={image} formats={['avif', 'webp']} alt={imageAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 520px, 92vw" loading="eager" fetchpriority="high" />
            </div>
          )}
          {badgeIcon && badgeText && (
            <div class="phero__badge">
              <span class="icon-ring">
                <Icon name={badgeIcon} />
              </span>
              <span>{badgeText}</span>
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 1.5rem + 4vw, 5rem));
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background:
      radial-gradient(110% 80% at 82% -10%, rgb(212 175 106 / 0.26) 0%, rgb(212 175 106 / 0.07) 38%, transparent 64%),
      linear-gradient(180deg, #ffffff 0%, #fdfaf4 50%, #f4ece0 100%);
  }

  /* Dark text needs dark grid lines and a multiply grain */
  .phero :global(.bg-grid) {
    background-image:
      linear-gradient(rgb(6 23 49 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(6 23 49 / 0.045) 1px, transparent 1px);
  }

  .phero.grain::before {
    opacity: 0.035;
    mix-blend-mode: multiply;
  }

  .phero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .phero__glow {
    width: 42rem;
    height: 42rem;
    right: -10rem;
    top: -12rem;
    background: radial-gradient(closest-side, rgb(212 175 106 / 0.4), transparent);
    opacity: 0.6;
  }

  .phero__ring {
    position: absolute;
    right: max(-8rem, calc((100% - var(--container)) / 2 - 8rem));
    top: 50%;
    width: min(620px, 70vw);
    transform: translateY(-45%);
    opacity: 0.9;
    animation: phero-spin 90s linear infinite;
  }

  @media (max-width: 767px) {
    .phero__ring {
      opacity: 0.35;
      right: -40%;
      width: 110vw;
    }
  }

  .phero__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .phero--media .phero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
  }

  .phero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 46rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--fg-subtle);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .crumbs a {
    color: var(--fg-muted);
    transition: color 0.25s;
  }

  .crumbs a:hover {
    color: var(--gold-800);
  }

  .crumbs [aria-current] {
    color: var(--gold-800);
  }

  .crumbs :global(.icon) {
    opacity: 0.5;
  }

  .phero__title {
    max-width: 18ch;
  }

  .phero:not(.phero--media) .phero__title {
    max-width: 20ch;
  }

  .phero__lead {
    max-width: 38rem;
  }

  .phero__actions {
    margin-top: 0.75rem;
  }

  @media (max-width: 479px) {
    .phero__actions {
      justify-self: stretch;
    }
  }

  .phero__media {
    position: relative;
    width: 100%;
    max-width: 620px;
    justify-self: center;
    padding: 0 0 1.5rem 1.5rem;
  }

  .phero__media--custom {
    padding: 0;
  }

  .phero__line {
    position: absolute;
    inset: 1.5rem 1.5rem 0 0;
    border: 1px solid rgb(185 141 54 / 0.4);
    border-radius: var(--radius-lg);
  }

  .phero__media :global(.phero__screen) {
    position: relative;
  }

  .phero__frame {
    aspect-ratio: 5 / 4;
  }

  .phero__badge {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: calc(100% - 2rem);
    padding: 0.55rem 1.2rem 0.55rem 0.55rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgb(185 141 54 / 0.28);
    box-shadow: 0 18px 40px -24px rgb(6 23 49 / 0.55);
    color: var(--navy-900);
    font-weight: 650;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .phero__badge :global(.icon-ring) {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--navy-900);
    color: var(--gold-300);
    border-color: transparent;
  }

  @keyframes phero-spin {
    to {
      transform: translateY(-45%) rotate(360deg);
    }
  }
</style>
