---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Caption shown in the window bar */
  label?: string;
  /** Crop to a fixed aspect ratio (e.g. "16 / 10") instead of the screenshot's own */
  ratio?: string;
  /** "gold" = navy bar + gold border, for dark sections */
  tone?: 'light' | 'gold';
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  label = 'TallyPrime',
  ratio,
  tone = 'light',
  sizes = '(min-width: 1024px) 560px, 92vw',
  widths = [480, 768, 1100, 1600],
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<figure class:list={['screen', { 'screen--ratio': !!ratio, 'screen--gold': tone === 'gold' }, className]} style={ratio ? `--screen-ratio:${ratio}` : undefined}>
  <div class="screen__bar" aria-hidden="true">
    <span class="screen__dots"><i></i><i></i><i></i></span>
    <span class="screen__label">{label}</span>
  </div>
  <div class="screen__body">
    <Picture src={src} formats={['avif', 'webp']} alt={alt} widths={widths} sizes={sizes} loading={loading} />
  </div>
</figure>
