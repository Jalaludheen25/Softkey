---
import { Picture } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { SERVICE_GROUPS, servicesInGroup, serviceHref } from '@/data/services';
---

<section class="svc theme-dark section grain" aria-labelledby="svc-title">
  <div class="bg-glow svc__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head section-head--split">
      <div class="svc__head">
        <p class="eyebrow" data-reveal>What we do</p>
        <h2 id="svc-title" class="h2" data-reveal style="--d:1">
          Everything your business needs from <em class="accent">Tally</em>, in one place.
        </h2>
      </div>
      <div class="svc__intro" data-reveal style="--d:2">
        <p class="lead">
          From the first license to the hundredth report — our services cover the full life of your Tally setup, delivered by one team that
          knows your business.
        </p>
        <a class="link-arrow" href="/services/">Explore all services <Icon name="arrow-up-right" /></a>
      </div>
    </div>

    <div class="svc__body" data-svc>
      <div class="svc__media" aria-hidden="true">
        <div class="svc__media-inner frame">
          {
            SERVICE_GROUPS.map((g, i) => (
              <div class:list={['svc__img', { 'is-active': i === 0 }]} data-svc-img={i}>
                <Picture src={g.image} formats={['avif', 'webp']} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 520px, 1px" loading="lazy" />
              </div>
            ))
          }
          <div class="svc__media-shade"></div>
          <div class="svc__media-meta">
            {
              SERVICE_GROUPS.map((g, i) => (
                <span class:list={['svc__media-label', { 'is-active': i === 0 }]} data-svc-label={i}>
                  <Icon name={g.icon} size={18} />
                  {g.title}
                </span>
              ))
            }
            <span class="svc__media-count"><b data-svc-count>01</b> / 0{SERVICE_GROUPS.length}</span>
          </div>
        </div>
      </div>

      <ol class="svc__list" role="list">
        {
          SERVICE_GROUPS.map((g, i) => (
            <li class:list={['svc__row', 'spotlight', { 'is-active': i === 0 }]} data-svc-row={i} data-reveal style={`--d:${i}`}>
              <div class="svc__thumb frame">
                <Picture src={g.image} formats={['avif', 'webp']} alt={g.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 1px, 92vw" loading="lazy" />
              </div>
              <span class="svc__num" aria-hidden="true">0{i + 1}</span>
              <div class="svc__main">
                <h3 class="h3">
                  <a href={`/services/#${g.id}`} class="svc__title">
                    {g.title}
                  </a>
                </h3>
                <p class="svc__summary">{g.summary}</p>
                <ul class="svc__tags" role="list">
                  {servicesInGroup(g.id).map((s) => (
                    <li>
                      <a href={serviceHref(s.slug)}>
                        {s.navTitle}
                        <Icon name="arrow-up-right" size={14} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <span class="svc__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={22} />
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .svc {
    background: linear-gradient(180deg, #050c1f 0%, #071531 100%);
    overflow: clip;
  }

  .svc__glow {
    width: 40rem;
    height: 40rem;
    left: -18rem;
    top: 20%;
    background: radial-gradient(closest-side, rgb(212 175 106 / 0.14), transparent);
  }

  .svc__head {
    display: grid;
    gap: 1.1rem;
  }

  .svc__intro {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .svc__body {
    position: relative;
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  @media (min-width: 1024px) {
    .svc__body {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
      align-items: start;
    }
  }

  /* ---- Sticky image (desktop) ---- */
  .svc__media {
    display: none;
  }

  @media (min-width: 1024px) {
    .svc__media {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .svc__media-inner {
    aspect-ratio: 4 / 4.6;
    background: var(--navy-850);
  }

  .svc__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.8s var(--ease-out),
      transform 1.4s var(--ease-out);
  }

  .svc__img.is-active {
    opacity: 1;
    transform: none;
  }

  .svc__img :global(picture) {
    height: 100%;
  }

  .svc__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc__media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(5 12 31 / 0.88) 100%);
  }

  .svc__media-meta {
    position: absolute;
    inset: auto 1.5rem 1.4rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .svc__media-label {
    position: absolute;
    left: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: rgb(5 12 31 / 0.6);
    border: 1px solid rgb(212 175 106 / 0.35);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-weight: 650;
    font-size: 0.9rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .svc__media-label :global(.icon) {
    color: var(--gold-300);
  }

  .svc__media-label.is-active {
    opacity: 1;
    transform: none;
  }

  .svc__media-count {
    margin-left: auto;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-300);
  }

  .svc__media-count b {
    font-weight: 400;
    font-size: 2rem;
    color: var(--gold-300);
  }

  /* ---- List ---- */
  .svc__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .svc__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem 1.25rem;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) clamp(0.25rem, 0.5vw, 1rem);
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius);
    transition: background-color 0.5s var(--ease-out);
  }

  .svc__row.is-active {
    background: rgb(255 255 255 / 0.025);
  }

  .svc__thumb {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    border-radius: var(--radius);
  }

  .svc__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .svc__thumb {
      display: none;
    }
  }

  .svc__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
    line-height: 1.1;
    color: var(--gold-400);
    min-width: 2.2ch;
  }

  .svc__main {
    display: grid;
    gap: 0.65rem;
  }

  .svc__title {
    background-image: linear-gradient(var(--gold-300), var(--gold-300));
    background-size: 0 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      background-size 0.5s var(--ease-out),
      color 0.3s;
  }

  .svc__row:hover .svc__title,
  .svc__title:focus-visible {
    color: var(--gold-200);
    background-size: 100% 1px;
  }

  .svc__title::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .svc__row {
    position: relative;
  }

  .svc__summary {
    color: var(--fg-muted);
    max-width: 40rem;
  }

  .svc__tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .svc__tags a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--ink-200);
    transition:
      border-color 0.3s,
      color 0.3s,
      background-color 0.3s;
  }

  .svc__tags a :global(.icon) {
    color: var(--gold-400);
  }

  .svc__tags a:hover {
    border-color: var(--gold-400);
    color: #fff;
    background: rgb(212 175 106 / 0.08);
  }

  .svc__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    color: var(--gold-300);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s,
      color 0.4s,
      border-color 0.4s;
  }

  .svc__row:hover .svc__arrow,
  .svc__row.is-active .svc__arrow {
    background: var(--grad-gold);
    border-color: transparent;
    color: var(--navy-950);
    transform: rotate(45deg);
  }

  @media (max-width: 639px) {
    .svc__row {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .svc__arrow {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-row]'));
    const imgs = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-img]'));
    const labels = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-label]'));
    const count = root.querySelector<HTMLElement>('[data-svc-count]');
    const activate = (i: number) => {
      rows.forEach((r, j) => r.classList.toggle('is-active', i === j));
      imgs.forEach((r, j) => r.classList.toggle('is-active', i === j));
      labels.forEach((r, j) => r.classList.toggle('is-active', i === j));
      if (count) count.textContent = String(i + 1).padStart(2, '0');
    };
    rows.forEach((row, i) => {
      row.addEventListener('mouseenter', () => activate(i));
      row.addEventListener('focusin', () => activate(i));
    });
  });
</script>
