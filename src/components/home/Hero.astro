---
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { whatsappLink, LOCATIONS } from '@/data/site';
import { PARTNERS } from '@/data/partners';
import { SERVICES } from '@/data/services';

const bars = [38, 52, 46, 64, 58, 72, 66, 84, 78, 92, 86, 100];
const months = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'];
// Smooth line through bar tops
const pts = bars.map((b, i) => [8 + i * (304 / (bars.length - 1)), 118 - b * 0.92]);
const line = pts.map((p, i) => (i === 0 ? `M${p[0]} ${p[1]}` : `L${p[0].toFixed(1)} ${p[1].toFixed(1)}`)).join(' ');
const area = `${line} L312 124 L8 124 Z`;
---

<section class="hero theme-light grain" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-glow hero__glow hero__glow--a"></div>
    <div class="bg-glow hero__glow hero__glow--b"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__badge" data-reveal>
        <span class="hero__badge-dot" aria-hidden="true"></span>
        Channel partner for
        <img src="/brand/tally-script.svg" alt="Tally" class="hero__badge-logo" width="43" height="21" />
        <span class="hero__badge-sep" aria-hidden="true"></span>
        <span class="hero__badge-cities">{LOCATIONS.map((l) => l.city).join(' · ')}</span>
      </p>

      <h1 id="hero-title" class="hero__title" data-split>
        <span class="line" style="--l:0">
          <span>
            <img src="/brand/tally-script.svg" alt="Tally" class="title-logo hero__tally" width="43" height="21" fetchpriority="high" />
            <span class="hero__title-rest">, Accounting &amp;</span>
          </span>
        </span>
        <span class="line" style="--l:1"><span><em class="accent">Business Management</em></span></span>
        <span class="line" style="--l:2"><span>Solutions</span></span>
      </h1>

      <p class="lead hero__lead" data-reveal style="--d:4">
        Softkey Technologies helps businesses choose, implement, customize and support TallyPrime — along with the cloud, mobile and billing apps
        that work around it. One partner, from first license to everyday support.
      </p>

      <div class="btn-row btn-row--stack-sm" data-reveal style="--d:5">
        <a class="btn btn--gold btn--lg" href="/contact/">
          Get Started
          <Icon name="arrow-right" class="icon--arrow" stroke={2} />
        </a>
        <a class="btn btn--outline btn--lg" href={whatsappLink('Hello Softkey Technologies, I would like to talk to a Tally expert.')} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Talk to an Expert
        </a>
      </div>

      <dl class="hero__facts" data-reveal style="--d:6">
        <div>
          <dt>Branches in Kerala &amp; Karnataka</dt>
          <dd>{LOCATIONS.length}</dd>
        </div>
        <div>
          <dt>Channel-partner products</dt>
          <dd>{PARTNERS.length}</dd>
        </div>
        <div>
          <dt>Specialised services</dt>
          <dd>{SERVICES.length}</dd>
        </div>
      </dl>
    </div>

    <div class="hero__visual" data-tilt-scope data-reveal="zoom" style="--d:3">
      <div class="hv" data-tilt="6">
        <svg class="hv__rings" viewBox="0 0 600 600" aria-hidden="true">
          <defs>
            <linearGradient id="ringGold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#C79D52" stop-opacity="0.95"></stop>
              <stop offset="0.5" stop-color="#B98D36" stop-opacity="0.35"></stop>
              <stop offset="1" stop-color="#D4AF6A" stop-opacity="0.9"></stop>
            </linearGradient>
          </defs>
          <g class="hv__ring hv__ring--1"><circle cx="300" cy="300" r="286" fill="none" stroke="url(#ringGold)" stroke-width="1" stroke-dasharray="2 10"></circle></g>
          <g class="hv__ring hv__ring--2">
            <circle cx="300" cy="300" r="232" fill="none" stroke="url(#ringGold)" stroke-width="1.4" stroke-dasharray="1210 248" stroke-dashoffset="61" stroke-linecap="round"></circle>
            <circle cx="464" cy="136" r="7" fill="#99EB26"></circle>
          </g>
          <g class="hv__ring hv__ring--3"><circle cx="300" cy="300" r="176" fill="none" stroke="rgb(6 23 49 / .07)" stroke-width="1"></circle></g>
        </svg>

        <div class="hv__panel">
          <div class="db">
            <div class="db__top">
              <div class="db__brand">
                <span class="db__logo"><Logo variant="icon" decorative /></span>
                <span>
                  <strong>Business Overview</strong>
                  <small>Illustrative dashboard</small>
                </span>
              </div>
              <span class="db__pill">H1 · Apr–Sep</span>
            </div>

            <div class="db__kpis">
              <div class="kpi">
                <span>Sales</span>
                <strong>₹18.46L</strong>
                <em class="up"><Icon name="trending-up" size={13} stroke={2} /> 12.4%</em>
              </div>
              <div class="kpi">
                <span>Receivables</span>
                <strong>₹6.21L</strong>
                <em>32 parties</em>
              </div>
              <div class="kpi">
                <span>GST payable</span>
                <strong>₹1.08L</strong>
                <em>GSTR-3B</em>
              </div>
            </div>

            <div class="db__chart">
              <svg viewBox="0 0 320 130" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="dbArea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#D4AF6A" stop-opacity="0.5"></stop>
                    <stop offset="1" stop-color="#D4AF6A" stop-opacity="0"></stop>
                  </linearGradient>
                  <linearGradient id="dbLine" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" stop-color="#8F6B25"></stop>
                    <stop offset="1" stop-color="#D4AF6A"></stop>
                  </linearGradient>
                </defs>
                {[30, 60, 90].map((y) => <line x1="0" x2="320" y1={y} y2={y} stroke="rgb(6 23 49 / .07)" stroke-width="1" />)}
                {bars.map((b, i) => <rect class="db__bar" x={2 + i * (304 / (bars.length - 1))} y={124 - b * 0.92} width="12" height={b * 0.92} rx="3" style={`--i:${i}`} />)}
                <path d={area} fill="url(#dbArea)" class="db__area"></path>
                <path d={line} fill="none" stroke="url(#dbLine)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="db__line" pathLength="1"></path>
                <circle cx={pts[pts.length - 1][0]} cy={pts[pts.length - 1][1]} r="4.5" fill="#B98D36" class="db__point"></circle>
              </svg>
              <div class="db__months" aria-hidden="true">{months.map((m) => <span>{m}</span>)}</div>
            </div>

            <ul class="db__list" role="list">
              <li>
                <span class="db__tag db__tag--sale">Sales</span>
                <span class="db__ref">INV-0421</span>
                <span class="db__amt">₹42,500</span>
                <span class="db__status"><Icon name="circle-check" size={14} stroke={2} /> e-Invoice</span>
              </li>
              <li>
                <span class="db__tag db__tag--rcpt">Receipt</span>
                <span class="db__ref">RCT-0198</span>
                <span class="db__amt">₹18,000</span>
                <span class="db__status"><Icon name="circle-check" size={14} stroke={2} /> Bank</span>
              </li>
              <li>
                <span class="db__tag db__tag--pur">Purchase</span>
                <span class="db__ref">PUR-0310</span>
                <span class="db__amt">₹27,640</span>
                <span class="db__status"><Icon name="circle-check" size={14} stroke={2} /> ITC</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="hv__chip hv__chip--a">
          <div class="chip">
            <span class="chip__icon chip__icon--lime"><Icon name="file-check-2" size={18} /></span>
            <span><strong>GSTR-1 ready</strong><small>Invoices reconciled</small></span>
          </div>
        </div>
        <div class="hv__chip hv__chip--b">
          <div class="chip">
            <span class="chip__icon"><Icon name="truck" size={18} /></span>
            <span><strong>e-Way Bill generated</strong><small>From invoice INV-0421</small></span>
          </div>
        </div>
        <div class="hv__chip hv__chip--c">
          <div class="chip">
            <span class="chip__icon"><Icon name="cloud" size={18} /></span>
            <span><strong>Synced to cloud</strong><small><i class="live" aria-hidden="true"></i> Just now</small></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#intro" aria-label="Scroll to introduction">
    <span>Scroll</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 4.5rem));
    padding-bottom: clamp(4rem, 2.5rem + 5vw, 7rem);
    background:
      radial-gradient(120% 90% at 78% -10%, rgb(212 175 106 / 0.28) 0%, rgb(212 175 106 / 0.08) 35%, transparent 62%),
      linear-gradient(180deg, #ffffff 0%, #fdfaf4 45%, #f4ece0 100%);
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__glow--a {
    width: 46rem;
    height: 46rem;
    right: -12rem;
    top: -12rem;
    background: radial-gradient(closest-side, rgb(212 175 106 / 0.5), transparent);
    opacity: 0.58;
  }

  .hero__glow--b {
    width: 34rem;
    height: 34rem;
    left: -14rem;
    bottom: -16rem;
    background: radial-gradient(closest-side, rgb(35 76 160 / 0.16), transparent);
  }

  /* Grid lines have to be dark on a light background */
  .hero :global(.bg-grid) {
    background-image:
      linear-gradient(rgb(6 23 49 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(6 23 49 / 0.045) 1px, transparent 1px);
  }

  .hero.grain::before {
    opacity: 0.035;
    mix-blend-mode: multiply;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
      gap: 3rem;
      min-height: min(calc(100svh - var(--header-h) - 6rem), 760px);
    }
  }

  /* ---- Copy ---- */
  .hero__copy {
    container-type: inline-size;
  }

  .hero__badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(185 141 54 / 0.32);
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 10px 24px -18px rgb(6 23 49 / 0.5);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--gold-800);
  }

  .hero__badge-logo {
    display: inline-block;
    height: 1.2em;
    width: auto;
    transform: translateY(0.1em);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 4px rgb(107 168 27 / 0.22);
  }

  .hero__badge-sep {
    width: 1px;
    height: 12px;
    background: rgb(185 141 54 / 0.45);
  }

  @media (max-width: 479px) {
    .hero__badge-sep {
      display: none;
    }
  }

  .hero__badge-cities {
    color: var(--fg-muted);
    font-weight: 600;
  }

  .hero__title {
    margin-top: 1.6rem;
    /* Longest line is ~8.55em wide: scale with the column so it always fits on 3 lines */
    font-size: clamp(2rem, 11.4cqi, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
    font-weight: 650;
  }

  .hero__title .line {
    white-space: nowrap;
  }

  /* Tally's own logo, set to the cap height of the headline */
  .hero__title :global(.hero__tally) {
    margin-right: 0.02em;
  }

  .hero__title .accent {
    font-size: 1.1em;
    line-height: 0.9;
  }

  .hero__lead {
    margin-top: 1.6rem;
    max-width: 36rem;
  }

  .hero__copy .btn-row {
    margin-top: 2.2rem;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(6 23 49 / 0.12);
    max-width: 34rem;
  }

  .hero__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .hero__facts dd {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2.2rem, 1.8rem + 1.4vw, 3rem);
    line-height: 1;
    background: linear-gradient(100deg, #a87f2b 0%, #84621f 55%, #9c7527 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__facts dt {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--fg-subtle);
    font-weight: 600;
  }

  /* ---- Visual ---- */
  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
  }

  .hv {
    --rx: 0deg;
    --ry: 0deg;
    --px: 0;
    --py: 0;
    position: relative;
    display: grid;
    place-items: center;
    padding-block: clamp(2.75rem, 1.5rem + 6vw, 5.5rem);
  }

  .hv__rings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 108%;
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hv__ring {
    transform-origin: 300px 300px;
    transform-box: view-box;
  }

  .hv__ring--1 {
    animation: spin 120s linear infinite;
  }

  .hv__ring--2 {
    animation: spin 60s linear infinite reverse;
  }

  .hv__panel {
    position: relative;
    width: 88%;
    transform: perspective(1400px) rotateX(calc(5deg + var(--rx))) rotateY(calc(-10deg + var(--ry)));
    transition: transform 0.8s var(--ease-out);
  }

  .db {
    border-radius: 22px;
    padding: clamp(0.9rem, 0.6rem + 1.2vw, 1.4rem);
    background: linear-gradient(155deg, rgb(255 255 255 / 0.96), rgb(252 248 241 / 0.92));
    border: 1px solid rgb(6 23 49 / 0.08);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 50px 90px -35px rgb(6 23 49 / 0.35),
      0 0 0 1px rgb(185 141 54 / 0.12);
    font-size: clamp(0.62rem, 0.5rem + 0.35vw, 0.8rem);
  }

  .db__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .db__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 1.2;
  }

  .db__brand strong {
    display: block;
    color: var(--navy-900);
    font-size: 1.12em;
    font-weight: 700;
  }

  .db__brand small {
    color: var(--fg-subtle);
    font-size: 0.85em;
  }

  .db__logo {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 10px;
    background: var(--navy-900);
    border: 1px solid rgb(6 23 49 / 0.1);
    color: #fff;
  }

  .db__logo :global(.logo) {
    width: 1.8em;
  }

  .db__pill {
    padding: 0.35em 0.8em;
    border-radius: 999px;
    border: 1px solid rgb(185 141 54 / 0.4);
    background: rgb(212 175 106 / 0.1);
    color: var(--gold-800);
    font-weight: 650;
    white-space: nowrap;
  }

  .db__kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6em;
    margin-top: 1.1em;
  }

  .kpi {
    display: grid;
    gap: 0.15em;
    padding: 0.8em 0.9em;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgb(6 23 49 / 0.07);
    box-shadow: 0 10px 20px -18px rgb(6 23 49 / 0.45);
    min-width: 0;
  }

  .kpi span {
    color: var(--fg-subtle);
    font-weight: 600;
  }

  .kpi strong {
    color: var(--navy-900);
    font-size: 1.45em;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .kpi em {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-style: normal;
    color: var(--fg-subtle);
    font-size: 0.92em;
    white-space: nowrap;
  }

  .kpi em.up {
    color: #3c7c16;
  }

  .db__chart {
    margin-top: 1em;
    padding: 0.9em 0.9em 0.6em;
    border-radius: 14px;
    background: rgb(6 23 49 / 0.03);
    border: 1px solid rgb(6 23 49 / 0.06);
  }

  .db__chart svg {
    width: 100%;
    height: auto;
    aspect-ratio: 320 / 130;
    overflow: visible;
  }

  .db__bar {
    fill: rgb(6 23 49 / 0.08);
    transform-box: fill-box;
    transform-origin: bottom;
    animation: grow 1.2s var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms + 600ms);
  }

  .db__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.2s var(--ease-out) 900ms forwards;
  }

  .db__area {
    opacity: 0;
    animation: fade 1.2s var(--ease-out) 1.6s forwards;
  }

  .db__point {
    opacity: 0;
    animation:
      fade 0.6s 2.6s forwards,
      beacon 2.4s ease-in-out 3s infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .db__months {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5em;
    color: var(--fg-subtle);
    font-size: 0.85em;
    font-weight: 600;
  }

  .db__list {
    display: grid;
    gap: 0.35em;
    margin-top: 0.9em;
  }

  .db__list li {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0.8em;
    padding: 0.55em 0.7em;
    border-radius: 10px;
    background: rgb(6 23 49 / 0.035);
  }

  .db__tag {
    padding: 0.2em 0.6em;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.85em;
  }

  .db__tag--sale {
    background: rgb(212 175 106 / 0.2);
    color: #7a5a1c;
  }

  .db__tag--rcpt {
    background: rgb(60 124 22 / 0.14);
    color: #33690f;
  }

  .db__tag--pur {
    background: rgb(33 66 121 / 0.12);
    color: #1d3a6b;
  }

  .db__ref {
    color: var(--fg-muted);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .db__amt {
    color: var(--navy-900);
    font-weight: 700;
  }

  .db__status {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--fg-subtle);
    font-weight: 600;
  }

  .db__status :global(.icon) {
    color: #3c7c16;
    width: 1.1em;
    height: 1.1em;
  }

  /* ---- Floating chips ---- */
  .hv__chip {
    position: absolute;
    z-index: 2;
    transform: translate3d(calc(var(--px) * var(--depth, 28px)), calc(var(--py) * var(--depth, 28px)), 0);
    transition: transform 0.8s var(--ease-out);
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border-radius: 16px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.97), rgb(250 245 236 / 0.94));
    border: 1px solid rgb(6 23 49 / 0.08);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 24px 45px -22px rgb(6 23 49 / 0.45);
    font-size: clamp(0.7rem, 0.62rem + 0.3vw, 0.85rem);
    line-height: 1.25;
    white-space: nowrap;
    animation: float 7s ease-in-out infinite;
  }

  .chip strong {
    display: block;
    color: var(--navy-900);
    font-weight: 700;
  }

  .chip small {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--fg-subtle);
    font-size: 0.9em;
  }

  .chip__icon {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border-radius: 11px;
    color: var(--gold-800);
    background: rgb(212 175 106 / 0.16);
    border: 1px solid rgb(185 141 54 / 0.3);
  }

  .chip__icon--lime {
    color: #33690f;
    background: rgb(60 124 22 / 0.12);
    border-color: rgb(60 124 22 / 0.28);
  }

  .live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5fb318;
    box-shadow: 0 0 0 3px rgb(60 124 22 / 0.18);
  }

  .hv__chip--a {
    top: 3%;
    left: -3%;
    --depth: 34px;
  }

  .hv__chip--b {
    top: 49%;
    right: -5%;
    --depth: 42px;
  }

  .hv__chip--b .chip {
    animation-delay: -2.5s;
  }

  .hv__chip--c {
    bottom: 3%;
    left: -1%;
    --depth: 24px;
  }

  .hv__chip--c .chip {
    animation-delay: -4.5s;
  }

  @media (max-width: 520px) {
