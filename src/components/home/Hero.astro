---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import ScreenShot from '@/components/ScreenShot.astro';
import goldBox from '@/assets/products/tallyprime-gold-box.jpg';
import dashboardScreen from '@/assets/tally/dashboard.png';
import { whatsappLink, LOCATIONS } from '@/data/site';
import { PARTNERS } from '@/data/partners';
import { SERVICES } from '@/data/services';

---

<section class="hero theme-light grain" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-glow hero__glow hero__glow--a"></div>
    <div class="bg-glow hero__glow hero__glow--b"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__badge" data-reveal>
        <span class="hero__badge-dot" aria-hidden="true"></span>
        Channel partner for
        <img src="/brand/tally-script.svg" alt="Tally" class="hero__badge-logo" width="43" height="21" />
        <span class="hero__badge-sep" aria-hidden="true"></span>
        <span class="hero__badge-cities">{LOCATIONS.map((l) => l.city).join(' · ')}</span>
      </p>

      <h1 id="hero-title" class="hero__title" data-split>
        <span class="line" style="--l:0">
          <span>
            <img src="/brand/tally-script.svg" alt="Tally" class="title-logo hero__tally" width="43" height="21" fetchpriority="high" />
            <span class="hero__title-rest">, Accounting &amp;</span>
          </span>
        </span>
        <span class="line" style="--l:1"><span><em class="accent">Business Management</em></span></span>
        <span class="line" style="--l:2"><span>Solutions</span></span>
      </h1>

      <p class="lead hero__lead" data-reveal style="--d:4">
        Softkey Technologies helps businesses choose, implement, customize and support TallyPrime — along with the cloud, mobile and billing apps
        that work around it. One partner, from first license to everyday support.
      </p>

      <div class="btn-row btn-row--stack-sm" data-reveal style="--d:5">
        <a class="btn btn--gold btn--lg" href="/contact/">
          Get Started
          <Icon name="arrow-right" class="icon--arrow" stroke={2} />
        </a>
        <a class="btn btn--outline btn--lg" href={whatsappLink('Hello Softkey Technologies, I would like to talk to a Tally expert.')} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Talk to an Expert
        </a>
      </div>

      <dl class="hero__facts" data-reveal style="--d:6">
        <div>
          <dt>Branches in Kerala &amp; Karnataka</dt>
          <dd>{LOCATIONS.length}</dd>
        </div>
        <div>
          <dt>Channel-partner products</dt>
          <dd>{PARTNERS.length}</dd>
        </div>
        <div>
          <dt>Specialised services</dt>
          <dd>{SERVICES.length}</dd>
        </div>
      </dl>
    </div>

    <div class="hero__visual" data-tilt-scope data-reveal="zoom" style="--d:3">
      <div class="hv" data-tilt="6">
        <svg class="hv__rings" viewBox="0 0 600 600" aria-hidden="true">
          <defs>
            <linearGradient id="ringGold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#C79D52" stop-opacity="0.95"></stop>
              <stop offset="0.5" stop-color="#B98D36" stop-opacity="0.35"></stop>
              <stop offset="1" stop-color="#D4AF6A" stop-opacity="0.9"></stop>
            </linearGradient>
          </defs>
          <g class="hv__ring hv__ring--1"><circle cx="300" cy="300" r="286" fill="none" stroke="url(#ringGold)" stroke-width="1" stroke-dasharray="2 10"></circle></g>
          <g class="hv__ring hv__ring--2">
            <circle cx="300" cy="300" r="232" fill="none" stroke="url(#ringGold)" stroke-width="1.4" stroke-dasharray="1210 248" stroke-dashoffset="61" stroke-linecap="round"></circle>
            <circle cx="464" cy="136" r="7" fill="#99EB26"></circle>
          </g>
          <g class="hv__ring hv__ring--3"><circle cx="300" cy="300" r="176" fill="none" stroke="rgb(6 23 49 / .07)" stroke-width="1"></circle></g>
        </svg>

        <div class="hv__panel">
          <div class="hv__product">
            <div class="hv__screen">
              <ScreenShot
                src={dashboardScreen}
                alt="TallyPrime dashboard showing trading details, cash and bank balances and accounting ratios"
                label="TallyPrime"
                ratio="16 / 10"
                sizes="(min-width: 1024px) 430px, 62vw"
                widths={[430, 760, 1100]}
                loading="eager"
              />
            </div>
            <figure class="hv__box">
              <Image
                src={goldBox}
                alt="TallyPrime Gold — Unlimited Multi-User Edition software box"
                widths={[280, 560, 840]}
                sizes="(min-width: 1024px) 280px, 40vw"
                loading="eager"
                fetchpriority="high"
              />
            </figure>
            <p class="hv__tag">
              <Icon name="badge-check" size={16} stroke={2} />
              Gold · Unlimited multi-user
            </p>
          </div>
        </div>

        <div class="hv__chip hv__chip--a">
          <div class="chip">
            <span class="chip__icon chip__icon--lime"><Icon name="file-check-2" size={18} /></span>
            <span><strong>GSTR-1 ready</strong><small>Invoices reconciled</small></span>
          </div>
        </div>
        <div class="hv__chip hv__chip--b">
          <div class="chip">
            <span class="chip__icon"><Icon name="truck" size={18} /></span>
            <span><strong>e-Way Bill generated</strong><small>From invoice INV-0421</small></span>
          </div>
        </div>
        <div class="hv__chip hv__chip--c">
          <div class="chip">
            <span class="chip__icon"><Icon name="cloud" size={18} /></span>
            <span><strong>Synced to cloud</strong><small><i class="live" aria-hidden="true"></i> Just now</small></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#intro" aria-label="Scroll to introduction">
    <span>Scroll</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 4.5rem));
    padding-bottom: clamp(4rem, 2.5rem + 5vw, 7rem);
    background:
      radial-gradient(120% 90% at 78% -10%, rgb(212 175 106 / 0.28) 0%, rgb(212 175 106 / 0.08) 35%, transparent 62%),
      linear-gradient(180deg, #ffffff 0%, #fdfaf4 45%, #f4ece0 100%);
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__glow--a {
    width: 46rem;
    height: 46rem;
    right: -12rem;
    top: -12rem;
    background: radial-gradient(closest-side, rgb(212 175 106 / 0.5), transparent);
    opacity: 0.58;
  }

  .hero__glow--b {
    width: 34rem;
    height: 34rem;
    left: -14rem;
    bottom: -16rem;
    background: radial-gradient(closest-side, rgb(35 76 160 / 0.16), transparent);
  }

  /* Grid lines have to be dark on a light background */
  .hero :global(.bg-grid) {
    background-image:
      linear-gradient(rgb(6 23 49 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(6 23 49 / 0.045) 1px, transparent 1px);
  }

  .hero.grain::before {
    opacity: 0.035;
    mix-blend-mode: multiply;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
      gap: 3rem;
      min-height: min(calc(100svh - var(--header-h) - 6rem), 760px);
    }
  }

  /* ---- Copy ---- */
  .hero__copy {
    container-type: inline-size;
  }

  .hero__badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(185 141 54 / 0.32);
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 10px 24px -18px rgb(6 23 49 / 0.5);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--gold-800);
  }

  .hero__badge-logo {
    display: inline-block;
    height: 1.2em;
    width: auto;
    transform: translateY(0.1em);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 4px rgb(107 168 27 / 0.22);
  }

  .hero__badge-sep {
    width: 1px;
    height: 12px;
    background: rgb(185 141 54 / 0.45);
  }

  @media (max-width: 479px) {
    .hero__badge-sep {
      display: none;
    }
  }

  .hero__badge-cities {
    color: var(--fg-muted);
    font-weight: 600;
  }

  .hero__title {
    margin-top: 1.6rem;
    /* Longest line is ~8.55em wide: scale with the column so it always fits on 3 lines */
    font-size: clamp(2rem, 11.4cqi, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
    font-weight: 650;
  }

  .hero__title .line {
    white-space: nowrap;
  }

  /* Tally's own logo, set to the cap height of the headline */
  .hero__title :global(.hero__tally) {
    margin-right: 0.02em;
  }

  .hero__title .accent {
    font-size: 1.1em;
    line-height: 0.9;
  }

  .hero__lead {
    margin-top: 1.6rem;
    max-width: 36rem;
  }

  .hero__copy .btn-row {
    margin-top: 2.2rem;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(6 23 49 / 0.12);
    max-width: 34rem;
  }

  .hero__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .hero__facts dd {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2.2rem, 1.8rem + 1.4vw, 3rem);
    line-height: 1;
    background: linear-gradient(100deg, #a87f2b 0%, #84621f 55%, #9c7527 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__facts dt {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--fg-subtle);
    font-weight: 600;
  }

  /* ---- Visual ---- */
  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
  }

  .hv {
    --rx: 0deg;
    --ry: 0deg;
    --px: 0;
    --py: 0;
    position: relative;
    display: grid;
    place-items: center;
    padding-block: clamp(2.75rem, 1.5rem + 6vw, 5.5rem);
  }

  .hv__rings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 108%;
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hv__ring {
    transform-origin: 300px 300px;
    transform-box: view-box;
  }

  .hv__ring--1 {
    animation: spin 120s linear infinite;
  }

  .hv__ring--2 {
    animation: spin 60s linear infinite reverse;
  }

  .hv__panel {
    position: relative;
    width: 88%;
    transform: perspective(1400px) rotateX(calc(5deg + var(--rx))) rotateY(calc(-10deg + var(--ry)));
    transition: transform 0.8s var(--ease-out);
  }

  /* ---- Product composition: TallyPrime Gold box + a live screen ---- */
  .hv__product {
    position: relative;
    aspect-ratio: 1 / 0.9;
  }

  .hv__screen {
    position: absolute;
    right: 0;
    top: 2%;
    width: 74%;
  }

  .hv__box {
    position: absolute;
    left: 0;
    bottom: 6%;
    width: 47%;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #f1f1f1;
    box-shadow:
      0 0 0 1px rgb(185 141 54 / 0.28),
      0 40px 70px -28px rgb(6 23 49 / 0.55);
  }

  .hv__box :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .hv__tag {
    position: absolute;
    left: 6%;
    bottom: -1%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--navy-900);
    color: var(--gold-200);
    font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 0 16px 30px -18px rgb(6 23 49 / 0.8);
  }

  .hv__tag :global(.icon) {
    color: var(--gold-300);
  }

  /* ---- Floating chips ---- */
  .hv__chip {
    position: absolute;
    z-index: 2;
    transform: translate3d(calc(var(--px) * var(--depth, 28px)), calc(var(--py) * var(--depth, 28px)), 0);
    transition: transform 0.8s var(--ease-out);
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border-radius: 16px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.97), rgb(250 245 236 / 0.94));
    border: 1px solid rgb(6 23 49 / 0.08);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 24px 45px -22px rgb(6 23 49 / 0.45);
    font-size: clamp(0.7rem, 0.62rem + 0.3vw, 0.85rem);
    line-height: 1.25;
    white-space: nowrap;
    animation: float 7s ease-in-out infinite;
  }

  .chip strong {
    display: block;
    color: var(--navy-900);
    font-weight: 700;
  }

  .chip small {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--fg-subtle);
    font-size: 0.9em;
  }

  .chip__icon {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border-radius: 11px;
    color: var(--gold-800);
    background: rgb(212 175 106 / 0.16);
    border: 1px solid rgb(185 141 54 / 0.3);
  }

  .chip__icon--lime {
    color: #33690f;
    background: rgb(60 124 22 / 0.12);
    border-color: rgb(60 124 22 / 0.28);
  }

  .live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5fb318;
    box-shadow: 0 0 0 3px rgb(60 124 22 / 0.18);
  }

  .hv__chip--a {
    top: 3%;
    left: -3%;
    --depth: 34px;
  }

  .hv__chip--b {
    top: 49%;
    right: -5%;
    --depth: 42px;
  }

  .hv__chip--b .chip {
    animation-delay: -2.5s;
  }

  .hv__chip--c {
    bottom: -4%;
    left: 34%;
    --depth: 24px;
  }

  .hv__chip--c .chip {
    animation-delay: -4.5s;
  }

  @media (max-width: 520px) {
    .hv__chip--a {
      left: 0;
      top: 0;
    }
    .hv__chip--b {
      right: 0;
      top: 46%;
    }
    .hv__chip--c {
      left: 2%;
      bottom: 0;
    }
    .hv__panel {
      width: 94%;
    }
    .db__status {
      display: none;
    }
    .db__list li {
      grid-template-columns: auto 1fr auto;
    }
  }

  /* ---- Scroll cue ---- */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 42px;
    overflow: hidden;
    background: rgb(6 23 49 / 0.12);
  }

  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--gold-600));
    animation: scrollcue 2.2s var(--ease-in-out) infinite;
  }

  @media (min-width: 1024px) and (min-height: 760px) {
    .hero__scroll {
      display: flex;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @keyframes beacon {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.5);
    }
  }

  @keyframes scrollcue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }
</style>
