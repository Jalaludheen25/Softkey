---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { PARTNERS } from '@/data/partners';

interface Props {
  showLink?: boolean;
}
const { showLink = true } = Astro.props;

const n = PARTNERS.length;
const positions = PARTNERS.map((_, i) => {
  const a = (-90 + (360 / n) * i) * (Math.PI / 180);
  return { x: 50 + 40 * Math.cos(a), y: 50 + 40 * Math.sin(a) };
});
---

<section class="eco theme-light section" aria-labelledby="eco-title">
  <div class="container eco__grid">
    <div class="eco__copy">
      <p class="eyebrow" data-reveal>Channel partner for</p>
      <h2 id="eco-title" class="h2" data-reveal style="--d:1">
        One partner for <em class="accent">Tally</em> and its connected ecosystem
      </h2>
      <p class="lead" data-reveal style="--d:2">
        Softkey Technologies is a channel partner for six products that work together — so licensing, setup, training and support for your
        whole stack come from one accountable team.
      </p>
      <ul role="list" class="eco__names" data-reveal style="--d:3">
        {
          PARTNERS.map((p) => (
            <li>
              <strong>{p.name}</strong>
              <span>{p.category}</span>
            </li>
          ))
        }
      </ul>
      {
        showLink && (
          <a class="link-arrow" href="/partners/" data-reveal style="--d:4">
            Explore the ecosystem <Icon name="arrow-up-right" />
          </a>
        )
      }
    </div>

    <div class="eco__visual" data-reveal="zoom" style="--d:2">
      <div class="orbit">
        <svg class="orbit__lines" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="40" fill="none" stroke="rgb(143 107 37 / .28)" stroke-width="0.25"></circle>
          <circle class="orbit__dash" cx="50" cy="50" r="46" fill="none" stroke="rgb(143 107 37 / .35)" stroke-width="0.2" stroke-dasharray="0.6 1.6"></circle>
          <circle cx="50" cy="50" r="24" fill="none" stroke="rgb(6 23 49 / .08)" stroke-width="0.25"></circle>
          {positions.map((p) => <line x1="50" y1="50" x2={p.x} y2={p.y} stroke="rgb(143 107 37 / .3)" stroke-width="0.2" />)}
          {
            positions.map((p, i) => (
              <circle class="orbit__pulse" r="0.9" fill="#B98D36" style={`--i:${i}`}>
                <animateMotion dur="3.6s" begin={`${i * 0.6}s`} repeatCount="indefinite" path={`M${p.x} ${p.y} L50 50`} />
              </circle>
            ))
          }
        </svg>

        <div class="orbit__core">
          <Logo variant="icon" tone="light" decorative />
        </div>

        {
          PARTNERS.map((p, i) => (
            <div class="orbit__node" style={`left:${positions[i].x}%;top:${positions[i].y}%`}>
              <div class="plate">
                <Image src={p.logo} alt={`${p.name}${p.byline ? ' ' + p.byline : ''} logo`} widths={[160, 320]} sizes="140px" class="plate__img" loading="lazy" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .eco {
    background:
      radial-gradient(60% 60% at 100% 50%, rgb(185 141 54 / 0.08), transparent 70%),
      var(--ivory);
    overflow: clip;
  }

  .eco__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .eco__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 4rem;
    }
  }

  .eco__copy {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }

  .eco__names {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    width: 100%;
    margin-block: 0.5rem 0.75rem;
    border-top: 1px solid var(--border);
  }

  .eco__names li {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }

  .eco__names li:nth-child(odd) {
    padding-right: 1rem;
  }

  .eco__names strong {
    color: var(--fg-strong);
    font-weight: 700;
  }

  .eco__names span {
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
  }

  /* ---- Orbit ---- */
  .eco__visual {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .orbit {
    position: relative;
    aspect-ratio: 1;
  }

  .orbit__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit__dash {
    transform-origin: 50px 50px;
    animation: orbit-spin 90s linear infinite;
  }

  .orbit__core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    color: #fff;
    background:
      radial-gradient(circle at 30% 25%, #1b3a78, #061731 70%);
    box-shadow:
      0 0 0 10px rgb(6 23 49 / 0.05),
      0 0 0 22px rgb(185 141 54 / 0.07),
      0 30px 60px -20px rgb(6 23 49 / 0.6);
  }

  .orbit__core :global(.logo) {
    width: 58%;
  }

  .orbit__node {
    position: absolute;
    width: 25%;
    transform: translate(-50%, -50%);
  }

  .plate {
    display: grid;
    place-items: center;
    aspect-ratio: 1.3;
    padding: 12%;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgb(6 23 49 / 0.06);
    box-shadow:
      0 18px 36px -18px rgb(6 23 49 / 0.35),
      0 2px 6px -2px rgb(6 23 49 / 0.08);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .plate:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow:
      0 26px 44px -18px rgb(6 23 49 / 0.45),
      0 0 0 1px rgb(185 141 54 / 0.35);
  }

  .plate :global(.plate__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Grid fallback on small screens */
  @media (max-width: 639px) {
    .orbit {
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .orbit__lines,
    .orbit__core {
      display: none;
    }
    .orbit__node {
      position: static;
      width: auto;
      transform: none;
    }
    .plate {
      border-radius: 14px;
      padding: 14%;
    }
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit__pulse {
      display: none;
    }
  }
</style>
