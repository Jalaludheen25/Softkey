---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { PARTNERS } from '@/data/partners';
import { logoScale } from '@/lib/logo';

interface Props {
  showLink?: boolean;
}
const { showLink = true } = Astro.props;
---

<section class="eco theme-light section" aria-labelledby="eco-title">
  <div class="container eco__grid">
    <div class="eco__copy">
      <p class="eyebrow" data-reveal>Channel partner for</p>
      <h2 id="eco-title" class="h2" data-reveal style="--d:1">
        One partner for <em class="accent">Tally</em> and its connected ecosystem
      </h2>
      <p class="lead" data-reveal style="--d:2">
        Softkey Technologies is a channel partner for six products that work together — so licensing, setup, training and support for your
        whole stack come from one accountable team.
      </p>
      {
        showLink && (
          <a class="link-arrow" href="/partners/" data-reveal style="--d:3">
            Explore the ecosystem <Icon name="arrow-up-right" />
          </a>
        )
      }
    </div>

    <div class="eco__visual" data-reveal="zoom" style="--d:2">
      <span class="eco__ring" aria-hidden="true"></span>
      <ul class="eco__wall" role="list">
        {
          PARTNERS.map((p, i) => (
            <li class="eco__cell" style={`--d:${i}; --logo-scale:${logoScale(p)}`}>
              <span class="eco__logo">
                <Image src={p.logo} alt={`${p.name} logo`} widths={[200, 400]} sizes="180px" loading="lazy" />
              </span>
              <span class="eco__cat">{p.category}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .eco {
    background:
      radial-gradient(60% 60% at 100% 50%, rgb(185 141 54 / 0.08), transparent 70%),
      var(--ivory);
    overflow: clip;
  }

  .eco__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .eco__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
    }
  }

  .eco__copy {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }

  /* ---- Logo wall: every product in its own branding, sized consistently ---- */
  .eco__visual {
    position: relative;
    width: 100%;
  }

  .eco__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(120%, 40rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgb(185 141 54 / 0.25);
    box-shadow: 0 0 0 1px rgb(185 141 54 / 0.06) inset;
    pointer-events: none;
  }

  .eco__wall {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid rgb(6 23 49 / 0.07);
    box-shadow: 0 40px 80px -50px rgb(6 23 49 / 0.55);
    overflow: hidden;
  }

  @media (min-width: 560px) {
    .eco__wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .eco__cell {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.85rem;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem) 0.9rem;
    text-align: center;
    border-right: 1px solid rgb(6 23 49 / 0.07);
    border-bottom: 1px solid rgb(6 23 49 / 0.07);
    transition: background-color 0.4s var(--ease-out);
  }

  /* Remove the outer edges of the grid */
  .eco__cell:nth-child(2n) {
    border-right: 0;
  }

  .eco__cell:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  @media (min-width: 560px) {
    .eco__cell:nth-child(2n) {
      border-right: 1px solid rgb(6 23 49 / 0.07);
    }
    .eco__cell:nth-child(3n) {
      border-right: 0;
    }
    .eco__cell:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }

  .eco__cell:hover {
    background: var(--ivory);
  }

  /* The wrapper needs its own width, otherwise a percentage max-width on the
     image resolves against a shrink-to-fit box and collapses it. */
  .eco__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    height: calc(clamp(42px, 2rem + 1.5vw, 56px) * var(--logo-scale, 1));
  }

  .eco__logo :global(img) {
    height: 100%;
    width: auto;
    max-width: 92%;
    object-fit: contain;
    transition: transform 0.5s var(--ease-out);
  }

  .eco__cell:hover .eco__logo :global(img) {
    transform: scale(1.05);
  }

  .eco__cat {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--fg-subtle);
  }
</style>
