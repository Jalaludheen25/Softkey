---
/**
 * Ecosystem orbit: Softkey at the centre with the six channel-partner products
 * around it, joined by gold spokes. Used as the hero visual on Partners and Contact.
 */
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { PARTNERS } from '@/data/partners';
import { logoScale } from '@/lib/logo';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const n = PARTNERS.length;
// Node centres on a circle, first one at the top
const nodes = PARTNERS.map((p, i) => {
  const a = (-90 + (360 / n) * i) * (Math.PI / 180);
  return { partner: p, x: 50 + 39 * Math.cos(a), y: 50 + 39 * Math.sin(a), a };
});
---

<div class:list={['orbit', className]}>
  <svg class="orbit__lines" viewBox="0 0 100 100" aria-hidden="true">
    <circle class="orbit__dash" cx="50" cy="50" r="45" fill="none" stroke="rgb(185 141 54 / .3)" stroke-width="0.18" stroke-dasharray="0.7 1.8"></circle>
    <circle cx="50" cy="50" r="39" fill="none" stroke="rgb(185 141 54 / .32)" stroke-width="0.22"></circle>
    <circle cx="50" cy="50" r="24" fill="none" stroke="rgb(6 23 49 / .1)" stroke-width="0.22"></circle>
    {
      nodes.map(({ x, y }) => (
        <line x1="50" y1="50" x2={x.toFixed(2)} y2={y.toFixed(2)} stroke="rgb(185 141 54 / .34)" stroke-width="0.2" />
      ))
    }
    {
      nodes.map(({ a }, i) => (
        <circle
          class="orbit__dot"
          cx={(50 + 20 * Math.cos(a)).toFixed(2)}
          cy={(50 + 20 * Math.sin(a)).toFixed(2)}
          r="0.85"
          fill="#b98d36"
          style={`--i:${i}`}
        />
      ))
    }
  </svg>

  <div class="orbit__core">
    <Logo variant="icon" decorative />
  </div>

  <ul class="orbit__nodes" role="list">
    {
      nodes.map(({ partner, x, y }) => (
        <li class="orbit__node" style={`left:${x}%; top:${y}%; --logo-scale:${logoScale(partner)}`}>
          <span class="plate">
            <Image src={partner.logo} alt={`${partner.name} logo`} widths={[160, 320]} sizes="150px" loading="eager" />
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .orbit {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .orbit__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit__dash {
    transform-origin: 50px 50px;
    animation: orbit-spin 90s linear infinite;
  }

  .orbit__dot {
    opacity: 0.85;
    animation: orbit-pulse 3.2s var(--ease-in-out) infinite;
    animation-delay: calc(var(--i) * 0.5s);
    transform-box: fill-box;
    transform-origin: center;
  }

  .orbit__core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 29%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    color: #fff;
    background: radial-gradient(circle at 32% 26%, #1d4183, #071733 72%);
    box-shadow:
      0 0 0 10px rgb(6 23 49 / 0.04),
      0 0 0 22px rgb(185 141 54 / 0.06),
      0 28px 50px -22px rgb(6 23 49 / 0.65);
  }

  .orbit__core :global(.logo) {
    width: 58%;
  }

  .orbit__nodes {
    margin: 0;
  }

  .orbit__node {
    position: absolute;
    width: 28%;
    transform: translate(-50%, -50%);
  }

  .plate {
    display: grid;
    place-items: center;
    aspect-ratio: 1.24;
    padding: 7%;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgb(6 23 49 / 0.05);
    box-shadow:
      0 18px 34px -20px rgb(6 23 49 / 0.45),
      0 2px 6px -2px rgb(6 23 49 / 0.1);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .plate:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow:
      0 26px 44px -20px rgb(6 23 49 / 0.5),
      0 0 0 1px rgb(185 141 54 / 0.4);
  }

  .plate :global(img) {
    height: calc(clamp(30px, 1.4rem + 2.4vw, 58px) * var(--logo-scale, 1));
    width: auto;
    max-width: 94%;
    object-fit: contain;
  }

  /* Phones: the orbit gets too tight, so lay the plates out in a grid */
  @media (max-width: 599px) {
    .orbit {
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
      max-width: 420px;
    }

    .orbit__lines,
    .orbit__core {
      display: none;
    }

    .orbit__nodes {
      display: contents;
    }

    .orbit__node {
      position: static;
      width: auto;
      transform: none;
    }

    .plate {
      border-radius: 14px;
      padding: 10%;
    }
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-pulse {
    0%,
    100% {
      transform: scale(0.7);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.25);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit__dot {
      animation: none;
    }
  }
</style>
